<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Boletín de evaluación" style="@style/TituloPantalla" />
        <!-- TODO: construye la interfaz completa siguiendo los id del PDF:
             etBloque1, etBloque2, etBloque3 (decimales), btnEvaluar, btnLimpiar, tvNota, tvEstado.
             Aplica los estilos definidos en res/values/styles.xml. -->
        <EditText android:id="@+id/etBloque1" style="@style/CampoFormulario"
            android:hint="Nota del bloque 1" android:inputType="numberDecimal|numberSigned"
            />
        <EditText android:id="@+id/etBloque2" style="@style/CampoFormulario"
            android:hint="Nota del bloque 2" android:inputType="numberDecimal|numberSigned"/>
        <EditText android:id="@+id/etBloque3" style="@style/CampoFormulario"
            android:hint="Nota del bloque 3" android:inputType="numberDecimal|numberSigned"/>
        <Button android:id="@+id/btnEvaluar" style="@style/BotonPrincipal" android:text="Ver nota"/>
        <Button android:id="@+id/btnLimpiar" style="@style/BotonSecundario" android:text="Limpiar"/>
        <TextView android:id="@+id/tvNota" style="@style/TextoResultado"
            android:text="Ponga las notas para ver el resultado" />
        <TextView android:id="@+id/tvEstado" style="@style/TextoResultado"
            android:text="Ponga las notas para ver si aprobastes" />
    </LinearLayout>
</ScrollView>